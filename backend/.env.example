# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/cbt-platform
# OR use MongoDB Atlas
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/cbt-platform?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_12345
JWT_REFRESH_EXPIRE=30d

# Email Configuration (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_from_gmail
EMAIL_FROM_NAME=CBT Platform

# Frontend URL
CLIENT_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,csv,xlsx,xls

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Security
BCRYPT_ROUNDS=10

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# Socket.io Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100
